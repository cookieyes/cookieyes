{
  "name": "cookieyes",
  "version": "0.0.0",
  "private": true,
  "description": "CookieYes Consent SDK — open-source, developer-first cookie consent for the web (Turborepo + pnpm workspaces)",
  "homepage": "https://github.com/cookieyes/cookieyes#readme",
  "bugs": {
    "url": "https://github.com/cookieyes/cookieyes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookieyes/cookieyes.git"
  },
  "license": "MIT",
  "author": "CookieYes (https://www.cookieyes.com)",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build --filter='./sdk/*'",
    "dev": "turbo run dev --filter='./sdk/*'",
    "test": "turbo run test --filter='./sdk/*'",
    "typecheck": "turbo run typecheck --filter='./sdk/*'",
    "dev:web": "pnpm --filter @cookieyes/web dev",
    "build:web": "turbo run build --filter=@cookieyes/web",
    "typecheck:web": "pnpm --filter @cookieyes/web typecheck",
    "check-examples:web": "turbo run check-examples --filter=@cookieyes/web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter='./sdk/*' && changeset publish",
    "peer-matrix:derive-check": "node matrix/scripts/derive-check.mjs",
    "peer-matrix:pack-tarballs": "node matrix/scripts/pack-tarballs.mjs",
    "peer-matrix:plan": "node matrix/scripts/print-combinations.mjs",
    "peer-matrix:run": "node matrix/scripts/run-combination.mjs",
    "peer-matrix:aggregate": "node matrix/scripts/aggregate-results.mjs",
    "peer-matrix:test": "vitest run matrix/scripts/__tests__"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@changesets/cli": "^2.31.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "semver": "^7.7.3",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.14"
    }
  }
}
