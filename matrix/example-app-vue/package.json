{
  "name": "peer-matrix-example-app-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.ts --outDir dist-ssr",
    "test:behaviour": "vitest run --config tests/vitest.config.mts"
  },
  "dependencies": {
    "@cookieyes/vue": "__TARBALL_VUE__",
    "@cookieyes/core": "__TARBALL_CORE__",
    "vue": "__VUE_VERSION__"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.14"
  },
  "pnpm": {
    "overrides": {
      "@cookieyes/core": "__TARBALL_CORE__",
      "@cookieyes/ui": "__TARBALL_UI__",
      "@cookieyes/vue": "__TARBALL_VUE__",
      "@cookieyes/test": "__TARBALL_TEST__",
      "@cookieyes/scripts": "__TARBALL_SCRIPTS__"
    }
  }
}
