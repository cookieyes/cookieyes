---
import { CookieYesRoot } from "@cookieyes/astro/components";

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
  </head>
  <body>
    <CookieYesRoot />
    <main><h1>{title}</h1><slot /></main>
  </body>
</html>
