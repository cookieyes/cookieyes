{
  "name": "@cookieyes/core",
  "version": "0.11.1",
  "description": "Headless consent engine — the single source of truth for all CookieYes consent logic",
  "keywords": [
    "cookie consent",
    "GDPR",
    "CCPA",
    "cookie banner",
    "consent management",
    "privacy",
    "compliance",
    "React",
    "Next.js",
    "TypeScript",
    "open source"
  ],
  "homepage": "https://developers.cookieyes.com/docs/core/getting-started/installation",
  "bugs": {
    "url": "https://github.com/cookieyes/cookieyes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookieyes/cookieyes.git",
    "directory": "sdk/core"
  },
  "license": "MIT",
  "author": "CookieYes (https://www.cookieyes.com)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./network-blocker": {
      "import": {
        "types": "./dist/network-blocker.d.ts",
        "default": "./dist/network-blocker.js"
      },
      "require": {
        "types": "./dist/network-blocker.d.cts",
        "default": "./dist/network-blocker.cjs"
      }
    },
    "./iframes": {
      "import": {
        "types": "./dist/iframes.d.ts",
        "default": "./dist/iframes.js"
      },
      "require": {
        "types": "./dist/iframes.d.cts",
        "default": "./dist/iframes.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
