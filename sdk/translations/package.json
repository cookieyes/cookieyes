{
  "name": "@cookieyes/translations",
  "version": "0.5.0",
  "description": "Curated translation catalog for the CookieYes consent SDK. Import only the locales you need — each is its own sub-path so unused languages don't bundle.",
  "keywords": [
    "cookie consent",
    "translations",
    "i18n",
    "GDPR",
    "CCPA",
    "cookie banner",
    "open source"
  ],
  "homepage": "https://developers.cookieyes.com/docs/nextjs/translations",
  "bugs": {
    "url": "https://github.com/cookieyes/cookieyes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookieyes/cookieyes.git",
    "directory": "sdk/translations"
  },
  "license": "MIT",
  "author": "CookieYes (https://www.cookieyes.com)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./en": {
      "import": {
        "types": "./dist/en.d.ts",
        "default": "./dist/en.js"
      },
      "require": {
        "types": "./dist/en.d.cts",
        "default": "./dist/en.cjs"
      }
    },
    "./es": {
      "import": {
        "types": "./dist/es.d.ts",
        "default": "./dist/es.js"
      },
      "require": {
        "types": "./dist/es.d.cts",
        "default": "./dist/es.cjs"
      }
    },
    "./fr": {
      "import": {
        "types": "./dist/fr.d.ts",
        "default": "./dist/fr.js"
      },
      "require": {
        "types": "./dist/fr.d.cts",
        "default": "./dist/fr.cjs"
      }
    },
    "./de": {
      "import": {
        "types": "./dist/de.d.ts",
        "default": "./dist/de.js"
      },
      "require": {
        "types": "./dist/de.d.cts",
        "default": "./dist/de.cjs"
      }
    },
    "./it": {
      "import": {
        "types": "./dist/it.d.ts",
        "default": "./dist/it.js"
      },
      "require": {
        "types": "./dist/it.d.cts",
        "default": "./dist/it.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@cookieyes/core": "workspace:*",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
