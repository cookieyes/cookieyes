{
  "name": "@cookieyes/devtools",
  "version": "0.1.1",
  "description": "In-page debugging panel for the CookieYes consent SDK — dev-only, provably absent from production bundles",
  "keywords": [
    "cookie consent",
    "GDPR",
    "CCPA",
    "devtools",
    "debugging",
    "React",
    "Next.js",
    "TypeScript",
    "open source"
  ],
  "homepage": "https://developers.cookieyes.com/docs/react/devtools",
  "bugs": {
    "url": "https://github.com/cookieyes/cookieyes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookieyes/cookieyes.git",
    "directory": "sdk/devtools"
  },
  "license": "MIT",
  "author": "CookieYes (https://www.cookieyes.com)",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/stub.d.ts",
        "require": "./dist/stub.d.cts"
      },
      "development": {
        "types": {
          "import": "./dist/index.d.ts",
          "require": "./dist/index.d.cts"
        },
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "import": "./dist/stub.js",
      "require": "./dist/stub.cjs"
    },
    "./styles.css": {
      "development": "./dist/styles.css",
      "default": "./dist/stub.css"
    }
  },
  "main": "./dist/stub.cjs",
  "module": "./dist/stub.js",
  "types": "./dist/stub.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c && cp src/styles.css dist/styles.css && cp src/stub.css dist/stub.css",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@cookieyes/core": ">=0.11.0 <1.0.0",
    "@cookieyes/react": ">=0.13.0 <1.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@cookieyes/core": "workspace:*",
    "@cookieyes/react": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
