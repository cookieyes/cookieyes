matrix/results/

# The global `next-env.d.ts` rule above would also hide the committed
# example-app template's copy — that one is a real checked-in file (not
# framework-regenerated in place; only its scratch copies get built), so
# un-ignore it explicitly.
!matrix/example-app/next-env.d.ts
